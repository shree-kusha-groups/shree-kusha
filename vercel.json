{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "https://www.shreekushaventures.in/",
      "statusCode": 301
    },
    {
      "source": "/emi-plans.html",
      "destination": "https://www.shreekushaventures.in/pricing.html",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shreekushaventures.in"
        }
      ],
      "destination": "https://www.shreekushaventures.in/:path*",
      "statusCode": 301
    }
  ]
}
